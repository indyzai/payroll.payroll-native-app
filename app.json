{
  "expo": {
    "name": "IndyzPay",
    "slug": "indyzpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "indyzpay",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/icons/ios/icon.png",
      "bundleIdentifier": "com.indyzai.payroll.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#173E34",
        "foregroundImage": "./assets/icons/android/adaptive-foreground.png",
        "monochromeImage": "./assets/icons/android/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/icons/android/icon.png",
      "package": "com.indyzai.payroll.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173E34",
          "image": "./assets/brand/splash.png",
          "imageWidth": 120,
          "ios": {
            "image": "./assets/icons/ios/splash.png"
          },
          "android": {
            "image": "./assets/icons/android/splash.png"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
